{
  "name": "cfms-client-tauri",
  "version": "0.60.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-focus-ring-contract.mjs && pnpm check:fluent && pnpm check:architecture",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:ui": "vitest run --project=ui",
    "test:shuffle": "vitest run --sequence.shuffle --sequence.seed=42",
    "test:scripts": "node --test scripts/check-architecture.test.mjs scripts/check-focus-ring-contract.test.mjs scripts/check-unused-i18n.test.mjs",
    "test:python": "python -B -m unittest discover -s scripts/tests -p test_*.py",
    "test:stability": "node scripts/check-test-stability.mjs",
    "tauri": "tauri",
    "assets:fonts": "node scripts/embed-font-assets.mjs",
    "app:version": "node scripts/client-version.mjs",
    "app:version:show": "node scripts/client-version.mjs show",
    "app:version:check": "node scripts/client-version.mjs check",
    "i18n:unused": "node scripts/check-unused-i18n.mjs",
    "test:i18n-unused": "node --test scripts/check-unused-i18n.test.mjs",
    "check:focus-styles": "node scripts/check-focus-ring-contract.mjs",
    "test:focus-styles": "node --test scripts/check-focus-ring-contract.test.mjs",
    "app:changelog": "node scripts/release-notes.mjs changelog",
    "app:changelog:check": "node scripts/release-notes.mjs check",
    "app:release-notes": "node scripts/release-notes.mjs export",
    "assets:fluent": "node scripts/generate-fluent-theme.mjs && node scripts/generate-fluent-icons.mjs",
    "check:fluent": "node scripts/generate-fluent-theme.mjs --check && node scripts/generate-fluent-icons.mjs --check",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:architecture": "node --test scripts/check-architecture.test.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fluentui/svg-icons": "1.1.344",
    "@fluentui/tokens": "1.0.0-alpha.24",
    "@fluentui/web-components": "3.1.3",
    "@lezer/highlight": "1.2.3",
    "@microsoft/fast-element": "3.0.0",
    "@microsoft/focusgroup-polyfill": "1.5.0",
    "@tanstack/svelte-virtual": "^3.13.52",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-biometric": "~2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "~2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "dompurify": "^3.4.17",
    "lottie-web": "^5.13.0",
    "markdown-it": "^14.3.3",
    "qrcode": "^1.5.4",
    "svelte-i18n": "^4.0.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^25.9.9",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.6.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
